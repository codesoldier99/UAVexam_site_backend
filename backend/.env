# UAV考点运营管理系统 - 本地开发环境配置

# 应用基础配置
APP_NAME=UAV考点运营管理系统
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/exam_site_dev_db

# MySQL配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=exam_site_dev_db
MYSQL_ROOT_PASSWORD=root

# 数据库连接配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=exam_site_dev_db
EXTERNAL_DB_PORT=3306

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置
SECRET_KEY=uav_local_dev_secret_key_2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 微信小程序配置
WECHAT_APP_ID=your_wechat_appid_here
WECHAT_APP_SECRET=your_wechat_secret_here

# 文件上传配置
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760

# CORS配置
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000

# 邮件配置
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_password
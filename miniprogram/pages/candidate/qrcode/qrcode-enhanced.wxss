/* pages/candidate/qrcode/qrcode-enhanced.wxss */

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.header {
  width: 100%;
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

/* 状态栏样式 */
.status-bar {
  width: 85%;
  max-width: 600rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 0 auto 60rpx auto;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 40rpx;
}

.status-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 200rpx;
}

.status-item:last-child {
  margin-bottom: 0;
}

.status-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.status-text {
  font-size: 26rpx;
  color: #666;
}

.countdown-time {
  font-size: 28rpx;
  font-weight: bold;
  color: #07C160;
}

.countdown-time.urgent {
  color: #E64340;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

.qrcode-container {
  width: 90%;
  max-width: 650rpx;
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
  padding: 50rpx 40rpx;
  margin: 0 auto 40rpx auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
}

.error-message {
  font-size: 28rpx;
  color: #E64340;
  text-align: center;
  margin: 30rpx 0;
}

.retry-button {
  background-color: #07C160;
  color: white;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.qrcode-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-wrapper {
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  margin-bottom: 20rpx;
}

.qrcode-canvas {
  width: 400rpx;
  height: 400rpx;
  border-radius: 8rpx;
}

.qr-status {
  margin: 20rpx 0;
  text-align: center;
}

.status-success, .status-generating {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.status-success {
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.status-generating {
  background: rgba(255, 165, 0, 0.1);
  color: #FFA500;
}

.status-icon {
  margin-right: 8rpx;
  font-size: 32rpx;
}

/* 二维码操作区域 */
.qr-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.manual-refresh-btn {
  background: linear-gradient(45deg, #4CAF50, #45a049);
  color: white;
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 32rpx;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
  transition: all 0.3s ease;
  border: none;
  min-width: 200rpx;
}

.manual-refresh-btn.refreshing {
  background: linear-gradient(45deg, #ff9800, #f57c00);
  animation: refreshPulse 1s infinite;
}

.manual-refresh-btn[disabled] {
  background: #ccc;
  box-shadow: none;
  opacity: 0.6;
}

@keyframes refreshPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.02); }
  100% { transform: scale(1); }
}

.manual-refresh-btn .refresh-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}


/* 底部提示区域 */
.tips-area {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: -10rpx;
}

.tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 24rpx;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 400;
}

/* 错误状态样式 */
.error-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-message {
  font-size: 28rpx;
  color: #E64340;
  text-align: center;
  margin: 20rpx 0;
  line-height: 1.5;
}

.retry-button {
  background: #E64340;
  color: white;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 25rpx;
  margin-top: 20rpx;
  border: none;
}

<!-- pages/candidate/qrcode/qrcode-enhanced.wxml -->
<view class="container">
  <view class="header">
    <view class="title">考试签到码</view>
    <view class="subtitle">请向工作人员出示此二维码进行签到</view>
  </view>

  <!-- 状态和倒计时区域 -->
  <view class="status-bar">
    <view class="status-item">
      <text class="status-text">有效时间: </text>
      <text class="countdown-time {{countdown <= 10 ? 'urgent' : ''}}">{{countdown}}秒</text>
    </view>
    <view class="status-item">
      <text class="status-text">上次刷新: {{lastRefreshTime || '刚刚'}}</text>
    </view>
  </view>

  <view class="qrcode-container">
    <view wx:if="{{loading}}" class="loading-container">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在加载二维码...</text>
    </view>
    
    <view wx:elif="{{errorMessage}}" class="error-container">
      <text class="error-icon">⚠️</text>
      <text class="error-message">{{errorMessage}}</text>
      <button class="retry-button" bindtap="refreshQRCode">重新生成</button>
    </view>
    
    <view wx:else class="qrcode-content">
      <view class="qrcode-wrapper">
        <canvas class="qrcode-canvas" canvas-id="qrcode" id="qrcode" data-refresh="{{canvasRefreshKey}}"></canvas>
      </view>
      
      <view class="qr-status">
        <view wx:if="{{qrCodeGenerated}}" class="status-success">
          <text class="status-icon">✅</text>
          <text>二维码已生成</text>
        </view>
        <view wx:else class="status-generating">
          <text class="status-icon">⏳</text>
          <text>生成中...</text>
        </view>
      </view>

      <!-- 手动刷新按钮 -->
      <view class="qr-actions">
        <button class="manual-refresh-btn {{refreshing ? 'refreshing' : ''}}" bindtap="refreshQRCode" disabled="{{refreshing}}">
          <text class="refresh-icon">{{refreshing ? '⏳' : '🔄'}}</text>
          <text>{{refreshing ? '刷新中' : '手动刷新'}}</text>
        </button>
      </view>
    </view>
  </view>


  <view class="tips-area">
    <view class="tips">
      <text class="tip-icon">💡</text>
      <text class="tip-text">二维码每分钟自动刷新，确保签到安全</text>
    </view>
  </view>
</view>
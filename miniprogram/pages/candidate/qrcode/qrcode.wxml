<!-- pages/candidate/qrcode/qrcode.wxml -->
<view class="container">
  <view wx:if="{{redirecting}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载增强版二维码...</text>
  </view>
  
  <view wx:else class="error-container">
    <icon type="warn" size="64" color="#E64340"></icon>
    <text class="error-message">{{errorMessage}}</text>
    <button class="retry-button" bindtap="onLoad">重试</button>
  </view>
</view>
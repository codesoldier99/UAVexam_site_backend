/* miniprogram/pages/candidate/profile/profile.wxss */

.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 180rpx;
}

/* Loading Overlay */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top: 4rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* Hero Section - 优化渐变色彩 */
.hero-section {
  position: relative;
  background: #fff;
  margin-bottom: 30rpx;
  overflow: hidden;
}

.hero-bg {
  height: 260rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  position: relative;
}

.hero-bg::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
}

.hero-content {
  position: relative;
  padding: 0 40rpx 50rpx;
  margin-top: -120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.avatar-container {
  position: relative;
  margin-bottom: 30rpx;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 8rpx solid #ffffff;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #ffffff;
  text-transform: uppercase;
}

.status-dot {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.user-info {
  width: 100%;
}

.user-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.user-id {
  font-size: 28rpx;
  color: #8a8a8a;
  margin-bottom: 20rpx;
}

.user-status {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
}

.status-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a90e2;
}

/* Quick Stats - 优化设计 */
.quick-stats {
  display: flex;
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 20rpx;
  transition: all 0.3s ease;
}

.stat-item:active {
  transform: scale(0.95);
}

.stat-info {
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #8a8a8a;
}

/* Info Cards - 优化卡片设计 */
.info-card {
  background: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 2rpx solid #f8f9fa;
}

.card-title {
  display: flex;
  align-items: center;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}


.card-content {
  padding: 40rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f8f9fa;
}

.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-label {
  font-size: 30rpx;
  color: #666;
  min-width: 160rpx;
  font-weight: 500;
}

.item-value {
  flex: 1;
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 500;
  text-align: right;
}


/* Logout Section - 主流小程序风格 */
.logout-section {
  margin: 40rpx 30rpx 120rpx;
  position: relative;
  z-index: 10;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border: 2rpx solid #ff4d4f;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 79, 0.1);
  position: relative;
  overflow: visible;
}

.logout-btn:active {
  background: #ff4d4f;
  transform: scale(0.98);
}

.logout-btn:active .logout-text {
  color: #fff;
}

.logout-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #ff4d4f;
  transition: color 0.3s ease;
  line-height: 1;
}

.logout-btn::after {
  border: none;
}

/* Status Modal - 优化弹窗设计 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.status-modal {
  background: #fff;
  border-radius: 24rpx;
  margin: 40rpx;
  max-width: 600rpx;
  width: 100%;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.close-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
  border-radius: 26rpx;
  transition: all 0.3s ease;
}

.close-btn:active {
  background-color: #f5f5f5;
  transform: scale(0.9);
}

.modal-content {
  padding: 40rpx;
}

.current-status {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.status-indicator {
  width: 28rpx;
  height: 28rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
}

.status-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.status-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* Responsive Design - 响应式优化 */
@media screen and (max-width: 750rpx) {
  .hero-content {
    padding: 0 30rpx 40rpx;
  }
  
  .quick-stats {
    margin: 0 24rpx 24rpx;
    padding: 32rpx 16rpx;
  }
  
  .stat-item {
    padding: 0 16rpx;
  }
  
  .stat-number {
    font-size: 36rpx;
  }
  
  .info-card, .settings-card {
    margin: 0 24rpx 24rpx;
  }
  
  .card-header, .card-content {
    padding: 32rpx;
  }
  
  .setting-item {
    padding: 32rpx;
  }
}

/* Animation Effects - 优化动画效果 */
.hero-section {
  animation: fadeInDown 0.8s ease-out;
}

.quick-stats, .info-card, .logout-section {
  animation: slideUp 0.8s ease-out;
}

.quick-stats {
  animation-delay: 0.1s;
}

.info-card:nth-child(3) {
  animation-delay: 0.2s;
}

.info-card:nth-child(4) {
  animation-delay: 0.3s;
}

.logout-section {
  animation-delay: 0.4s;
}

@keyframes fadeInDown {
  from {
    opacity: 0;
    transform: translateY(-60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Enhanced Interaction Effects */
.stat-item:hover {
  transform: translateY(-6rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.setting-item:hover {
  background-color: #f8f9fa;
}



/* Dark Mode Support */
@media (prefers-color-scheme: dark) {
  .container {
    background: #1a1a1a;
  }
  
  .info-card, .settings-card, .quick-stats {
    background: #2a2a2a;
    box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.3);
  }
  
  .user-name, .title-text, .item-value, .setting-text {
    color: #ffffff;
  }
  
  .user-id, .stat-label, .item-label {
    color: #cccccc;
  }
  
  .card-header, .info-item {
    border-bottom-color: #404040;
  }
}
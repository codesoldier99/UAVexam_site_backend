<!--miniprogram/pages/candidate/profile/profile.wxml-->
<view class="container">
  <!-- Loading Overlay -->
  <view class="loading-overlay" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
  </view>

  <!-- Hero Section -->
  <view class="hero-section">
    <view class="hero-bg"></view>
    <view class="hero-content">
      <!-- Avatar -->
      <view class="avatar-container">
        <view class="avatar-placeholder">
          <text class="avatar-text">{{candidateInfo.name ? candidateInfo.name.charAt(0) : '考'}}</text>
        </view>
        <view class="status-dot" style="background-color: {{getStatusColor(candidateInfo.status)}}"></view>
      </view>
      
      <!-- Basic Info -->
      <view class="user-info">
        <view class="user-name">{{candidateInfo.name || '考生'}}</view>
        <view class="user-id">ID: {{candidateInfo.id_number || candidateInfo.studentId || '--'}}</view>
        <view class="user-status">
          <text class="status-label">{{getStatusLabel(candidateInfo.status)}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Quick Stats -->
  <view class="quick-stats">
    <view class="stat-item" bindtap="goToSchedule">
      <view class="stat-info">
        <view class="stat-number">{{examStats.totalExams || 0}}</view>
        <view class="stat-label">考试安排</view>
      </view>
    </view>
    <view class="stat-item">
      <view class="stat-info">
        <view class="stat-number">{{examStats.completedExams || 0}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>
    <view class="stat-item">
      <view class="stat-info">
        <view class="stat-number">{{examStats.passRate || 0}}%</view>
        <view class="stat-label">通过率</view>
      </view>
    </view>
  </view>

  <!-- Personal Information Card -->
  <view class="info-card">
    <view class="card-header">
      <view class="card-title">
        <text class="title-text">个人信息</text>
      </view>
    </view>
    
    <view class="card-content">
      <view class="info-item">
        <view class="item-label">姓名</view>
        <view class="item-value">{{candidateInfo.name || '--'}}</view>
      </view>

      <view class="info-item">
        <view class="item-label">身份证号</view>
        <view class="item-value">{{candidateInfo.id_number || candidateInfo.idCard || '--'}}</view>
      </view>

      <view class="info-item">
        <view class="item-label">手机号</view>
        <view class="item-value">{{candidateInfo.phone || '--'}}</view>
      </view>

      <view class="info-item">
        <view class="item-label">邮箱</view>
        <view class="item-value">{{candidateInfo.email || '--'}}</view>
      </view>
    </view>
  </view>

  <!-- Institution Card -->
  <view class="info-card">
    <view class="card-header">
      <view class="card-title">
        <text class="title-text">机构信息</text>
      </view>
    </view>
    
    <view class="card-content">
      <view class="info-item">
        <view class="item-label">所属机构</view>
        <view class="item-value">{{candidateInfo.institution_name || candidateInfo.department || '--'}}</view>
      </view>
      
      <view class="info-item">
        <view class="item-label">考试产品</view>
        <view class="item-value">{{candidateInfo.exam_product_name || '--'}}</view>
      </view>
      
      <view class="info-item">
        <view class="item-label">报名时间</view>
        <view class="item-value">{{formatDate(candidateInfo.created_at) || '--'}}</view>
      </view>
    </view>
  </view>


  <!-- Logout Button -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">
      <text class="logout-text">退出登录</text>
    </button>
  </view>

  <!-- Status Modal -->
  <view class="modal-overlay" wx:if="{{showStatusModal}}" bindtap="hideStatus">
    <view class="status-modal" catchtap="">
      <view class="modal-header">
        <text class="modal-title">当前状态</text>
        <view class="close-btn" bindtap="hideStatus">×</view>
      </view>
      <view class="modal-content">
        <view class="current-status">
          <view class="status-indicator" style="background-color: {{getStatusColor(candidateInfo.status)}}"></view>
          <text class="status-name">{{getStatusLabel(candidateInfo.status)}}</text>
        </view>
        <view class="status-description">
          <text wx:if="{{candidateInfo.status === 'registered'}}">您已成功注册考试。</text>
          <text wx:elif="{{candidateInfo.status === 'confirmed'}}">您的考试注册已确认。</text>
          <text wx:elif="{{candidateInfo.status === 'checked_in'}}">您已完成考试签到。</text>
          <text wx:else>您已完成考试。</text>
        </view>
      </view>
    </view>
  </view>
</view>

/* 主容器 */
.dashboard-container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 0;
  box-sizing: border-box;
}

/* 顶部标题区域 */
.header-section {
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  text-align: center;
  margin-bottom: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 400;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin: 0 32rpx 40rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-2rpx);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
}

.stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.stat-icon .icon {
  font-size: 32rpx;
  color: #ffffff;
}

/* 不同统计卡片的图标颜色 */
.stat-card:nth-child(1) .stat-icon {
  background: linear-gradient(135deg, #4a90e2, #357abd);
}

.stat-card:nth-child(2) .stat-icon {
  background: linear-gradient(135deg, #7b68ee, #6a5acd);
}

.stat-card:nth-child(3) .stat-icon {
  background: linear-gradient(135deg, #32cd32, #228b22);
}

.stat-card:nth-child(4) .stat-icon {
  background: linear-gradient(135deg, #ffa500, #ff8c00);
}

.stat-content {
  flex: 1;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.2;
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 400;
}

/* 实时状态区域 */
.realtime-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 0 32rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.status-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

.status-indicator.online {
  background: #52c41a;
}

.status-indicator.offline {
  background: #ff4d4f;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

/* 进行中的考试 */
.ongoing-exams {
  margin-top: 20rpx;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #555;
  margin-bottom: 20rpx;
}

.exam-list {
  space-y: 15rpx;
}

.exam-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 4rpx solid #4a90e2;
}

.exam-info {
  margin-bottom: 16rpx;
}

.exam-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.exam-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.exam-location {
  font-size: 24rpx;
  color: #888;
}

.exam-progress {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.progress-bar {
  flex: 1;
  height: 6rpx;
  background: #e6f7ff;
  border-radius: 3rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a90e2, #357abd);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #4a90e2;
  font-weight: 500;
}

.exam-participants {
  text-align: right;
}

.participants-count {
  font-size: 22rpx;
  color: #666;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 今日考试概览 */
.today-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 0 32rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f0f0f0;
}

.date-text {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

/* 时间轴 */
.today-timeline {
  margin-top: 24rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 36rpx;
  width: 2rpx;
  height: calc(100% + 8rpx);
  background: #e8e8e8;
}

.timeline-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-dot.completed {
  background: #52c41a;
}

.timeline-dot.ongoing {
  background: #4a90e2;
  animation: pulse 2s infinite;
}

.timeline-dot.pending {
  background: #faad14;
}

.timeline-dot.cancelled {
  background: #ff4d4f;
}

.timeline-content {
  flex: 1;
}

.timeline-time {
  font-size: 24rpx;
  color: #4a90e2;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.timeline-details {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-item {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}

.detail-item.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

.detail-item.status-ongoing {
  background: #e6f7ff;
  color: #4a90e2;
}

.detail-item.status-pending {
  background: #fffbe6;
  color: #faad14;
}

.detail-item.status-cancelled {
  background: #fff2f0;
  color: #ff4d4f;
}

/* 下拉刷新提示样式 */
.refresh-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  margin: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx dashed #d9d9d9;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.hint-icon {
  font-size: 28rpx;
  color: #4a90e2;
  margin-bottom: 12rpx;
  animation: bounce 2s infinite;
}

.hint-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-6rpx);
  }
  60% {
    transform: translateY(-3rpx);
  }
}

/* 底部间距 */
.bottom-spacer {
  height: 120rpx;
}

/* 加载动画 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top: 6rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .timeline-details {
    flex-direction: column;
    gap: 8rpx;
  }
}
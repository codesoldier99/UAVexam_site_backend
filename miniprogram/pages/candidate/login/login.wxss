/* 考生登录页面 - 主流现代化设计 */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部区域 */
.header-section {
  position: relative;
  padding: 60rpx 40rpx 80rpx;
  flex-shrink: 0;
}

.back-btn {
  position: absolute;
  left: 40rpx;
  top: 60rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transition: all 0.3s ease;
}

.back-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.back-icon {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
}

.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.logo-circle {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.logo-text {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: bold;
}

.app-title {
  color: #ffffff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.welcome-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}

/* 表单区域 */
.form-section {
  flex: 1;
  padding: 0 40rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.login-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 12rpx;
}

.card-subtitle {
  font-size: 28rpx;
  color: #8a8a8a;
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.4;
}

/* 输入框样式 */
.input-container {
  margin-bottom: 40rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 16rpx;
  padding: 0 20rpx;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: #4a90e2;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(74, 144, 226, 0.1);
}

.input-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  color: #8a8a8a;
}

.input-field {
  flex: 1;
  padding: 32rpx 0;
  font-size: 32rpx;
  color: #1a1a1a;
  background: transparent;
  border: none;
}

.input-field::placeholder {
  color: #bbb;
}

/* 按钮样式 */
.primary-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4a90e2 0%, #357abd 100%);
  border: none;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(74, 144, 226, 0.3);
}

.primary-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(74, 144, 226, 0.4);
}

.primary-btn.disabled {
  background: #e9ecef;
  color: #adb5bd;
  box-shadow: none;
  transform: none;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.primary-btn.disabled .btn-text {
  color: #adb5bd;
}

.secondary-btn {
  flex: 1;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #6c757d;
  transition: all 0.3s ease;
}

.secondary-btn:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.secondary-btn[disabled] {
  background: #f1f3f4;
  color: #bbb;
  border-color: #e0e0e0;
}

/* 信息展示区域 */
.info-section {
  margin: 32rpx 0 40rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9ecef;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 28rpx;
  color: #6c757d;
  font-weight: 500;
}

.info-value {
  font-size: 30rpx;
  color: #1a1a1a;
  font-weight: 600;
  text-align: right;
  flex: 1;
  margin-left: 32rpx;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 20rpx;
}

/* 安全提示 */
.security-tips {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-top: auto;
  backdrop-filter: blur(10rpx);
}

.tip-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.tip-row:last-child {
  margin-bottom: 0;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #6c757d;
  line-height: 1.4;
  flex: 1;
}

/* 响应式设计 */
@media screen and (max-width: 750rpx) {
  .header-section {
    padding: 50rpx 30rpx 60rpx;
  }
  
  .form-section {
    padding: 0 30rpx 30rpx;
  }
  
  .login-card {
    padding: 40rpx 32rpx;
  }
  
  .card-title {
    font-size: 36rpx;
  }
  
  .card-subtitle {
    font-size: 26rpx;
  }
}

/* 动画效果 */
.login-card {
  animation: slideUp 0.6s ease-out;
}

.security-tips {
  animation: fadeIn 0.8s ease-out;
  animation-delay: 0.2s;
  animation-fill-mode: both;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 按钮点击后的样式重置 */
.primary-btn::after,
.secondary-btn::after {
  border: none;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .login-card {
    background: rgba(42, 42, 42, 0.95);
  }
  
  .card-title {
    color: #ffffff;
  }
  
  .card-subtitle {
    color: #cccccc;
  }
  
  .info-section {
    background: rgba(60, 60, 60, 0.8);
  }
  
  .info-label {
    color: #aaaaaa;
  }
  
  .info-value {
    color: #ffffff;
  }
  
  .security-tips {
    background: rgba(42, 42, 42, 0.95);
  }
  
  .tip-text {
    color: #aaaaaa;
  }
}
<!-- miniprogram/pages/candidate/schedule/schedule.wxml -->
<view class="schedule-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">考试安排</text>
    <text class="page-subtitle">查看您的考试时间安排</text>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-tabs">
    <view 
      wx:for="{{filterOptions}}" 
      wx:key="value"
      class="filter-tab {{currentTab === item.value ? 'active' : ''}}"
      data-tab="{{item.value}}"
      bindtap="switchTab"
    >
      <text class="tab-label">{{item.label}}</text>
      <text class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{isEmpty}}" class="empty-container">
    <image class="empty-icon" src="/images/empty-schedule.png" mode="aspectFit"></image>
    <text class="empty-title">暂无考试安排</text>
    <text class="empty-subtitle">请联系管理员确认考试信息</text>
    <button class="refresh-btn" bindtap="onRefresh">刷新</button>
  </view>

  <!-- 考试列表 -->
  <view wx:else class="exam-list">
    <view 
      wx:for="{{filteredExamList}}" 
      wx:key="id"
      class="exam-card {{item.status}}"
      data-exam-id="{{item.id}}"
      bindtap="showExamDetail"
    >
      <!-- 考试基本信息 -->
      <view class="exam-header">
        <view class="exam-title-row">
          <text class="exam-name">{{item.examName}}</text>
          <view class="exam-status {{item.status}}">
            <text class="status-text">{{getStatusInfo(item.status).label}}</text>
          </view>
        </view>
        <text class="exam-type">{{item.examType}}</text>
      </view>

      <!-- 时间信息 -->
      <view class="exam-time">
        <view class="time-row">
          <text class="time-icon">📅</text>
          <text class="time-text">{{item.formattedDate}}</text>
        </view>
        <view class="time-row">
          <text class="time-icon">⏰</text>
          <text class="time-text">{{item.formattedTimeRange}}</text>
        </view>
        <view wx:if="{{item.status === 'upcoming'}}" class="time-row">
          <text class="time-icon">⏳</text>
          <text class="time-text remaining">{{getTimeRemaining(item.startTime)}}</text>
        </view>
      </view>

      <!-- 地点信息 -->
      <view class="exam-location">
        <text class="location-icon">📍</text>
        <text class="location-text">{{item.locationDetail}}</text>
      </view>

      <!-- 成绩信息（已完成的考试） -->
      <view wx:if="{{item.status === 'completed' && item.score}}" class="exam-result">
        <text class="result-label">成绩：</text>
        <text class="result-score">{{item.score}}/{{item.totalMarks}}</text>
        <text wx:if="{{item.grade}}" class="result-grade">{{item.grade}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="exam-actions">
        <button 
          wx:if="{{item.status === 'upcoming'}}" 
          class="action-btn reminder-btn"
          data-exam-id="{{item.id}}"
          bindtap="setReminder"
          catchtap="setReminder"
        >
          设置提醒
        </button>
        <button class="action-btn detail-btn">查看详情</button>
      </view>
    </view>
  </view>

  <!-- 考试详情弹窗 -->
  <view wx:if="{{showExamDetail}}" class="modal-overlay" bindtap="hideExamDetail">
    <view class="modal-container" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{selectedExam.examName}}</text>
        <text class="modal-close" bindtap="hideExamDetail">×</text>
      </view>
      
      <view class="modal-content">
        <!-- 基本信息 -->
        <view class="detail-section">
          <text class="section-title">考试信息</text>
          <view class="detail-row">
            <text class="detail-label">考试类型：</text>
            <text class="detail-value">{{selectedExam.examType}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">考试时间：</text>
            <text class="detail-value">{{selectedExam.formattedDate}} {{selectedExam.formattedTimeRange}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">考试地点：</text>
            <text class="detail-value">{{selectedExam.locationDetail}}</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">考试时长：</text>
            <text class="detail-value">{{selectedExam.duration}}分钟</text>
          </view>
          <view class="detail-row">
            <text class="detail-label">总分：</text>
            <text class="detail-value">{{selectedExam.totalMarks}}分</text>
          </view>
        </view>

        <!-- 考试要求 -->
        <view class="detail-section">
          <text class="section-title">考试要求</text>
          <view class="requirements-list">
            <view wx:for="{{selectedExam.requirements}}" wx:key="*this" class="requirement-item">
              <text class="requirement-text">• {{item}}</text>
            </view>
          </view>
        </view>

        <!-- 考试说明 -->
        <view wx:if="{{selectedExam.description}}" class="detail-section">
          <text class="section-title">考试说明</text>
          <text class="description-text">{{selectedExam.description}}</text>
        </view>

        <!-- 成绩信息 -->
        <view wx:if="{{selectedExam.status === 'completed' && selectedExam.score}}" class="detail-section">
          <text class="section-title">考试成绩</text>
          <view class="score-display">
            <text class="score-number">{{selectedExam.score}}</text>
            <text class="score-total">/{{selectedExam.totalMarks}}</text>
            <text wx:if="{{selectedExam.grade}}" class="score-grade">{{selectedExam.grade}}</text>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn close-btn" bindtap="hideExamDetail">
          关闭
        </button>
      </view>
    </view>
  </view>
</view>
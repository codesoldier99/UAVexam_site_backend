<view class="dashboard-container">
  <!-- 顶部标题区域 -->
  <view class="header-section">
    <view class="header-title">实时看板</view>
    <view class="header-subtitle">考试数据实时监控</view>
  </view>

  <!-- 统计卡片区域 -->
  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-icon">
        <text class="icon">📊</text>
      </view>
      <view class="stat-content">
        <view class="stat-number">{{totalExams}}</view>
        <view class="stat-label">总考试数</view>
      </view>
    </view>

    <view class="stat-card">
      <view class="stat-icon">
        <text class="icon">👥</text>
      </view>
      <view class="stat-content">
        <view class="stat-number">{{totalCandidates}}</view>
        <view class="stat-label">总考生数</view>
      </view>
    </view>

    <view class="stat-card">
      <view class="stat-icon">
        <text class="icon">✅</text>
      </view>
      <view class="stat-content">
        <view class="stat-number">{{completedExams}}</view>
        <view class="stat-label">已完成</view>
      </view>
    </view>

    <view class="stat-card">
      <view class="stat-icon">
        <text class="icon">⏳</text>
      </view>
      <view class="stat-content">
        <view class="stat-number">{{ongoingExams}}</view>
        <view class="stat-label">进行中</view>
      </view>
    </view>
  </view>

  <!-- 实时状态区域 -->
  <view class="realtime-section">
    <view class="section-title">
      <text class="title-text">实时状态</text>
      <view class="status-indicator {{realtimeStatus}}"></view>
    </view>

    <!-- 进行中的考试 -->
    <view class="ongoing-exams">
      <view class="subsection-title">正在进行的考试</view>
      <view class="exam-list" wx:if="{{ongoingExamsList.length > 0}}">
        <view class="exam-item" wx:for="{{ongoingExamsList}}" wx:key="id">
          <view class="exam-info">
            <view class="exam-name">{{item.name}}</view>
            <view class="exam-time">{{item.startTime}} - {{item.endTime}}</view>
            <view class="exam-location">{{item.location}}</view>
          </view>
          <view class="exam-progress">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{item.progress}}%"></view>
            </view>
            <view class="progress-text">{{item.progress}}%</view>
          </view>
          <view class="exam-participants">
            <text class="participants-count">{{item.currentParticipants}}/{{item.totalParticipants}}</text>
          </view>
        </view>
      </view>
      <view class="empty-state" wx:else>
        <text class="empty-icon">📝</text>
        <text class="empty-text">暂无进行中的考试</text>
      </view>
    </view>
  </view>

  <!-- 今日考试概览 -->
  <view class="today-section">
    <view class="section-title">
      <text class="title-text">今日考试概览</text>
      <text class="date-text">{{todayDate}}</text>
    </view>

    <view class="today-timeline">
      <view class="timeline-item" wx:for="{{todayExams}}" wx:key="id">
        <view class="timeline-dot {{item.status}}"></view>
        <view class="timeline-content">
          <view class="timeline-time">{{item.time}}</view>
          <view class="timeline-title">{{item.name}}</view>
          <view class="timeline-details">
            <text class="detail-item">{{item.location}}</text>
            <text class="detail-item">{{item.participants}}人</text>
            <text class="detail-item status-{{item.status}}">{{item.statusText}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 快速操作区域 -->
  <view class="quick-actions">
    <view class="section-title">
      <text class="title-text">快速操作</text>
    </view>
    
    <view class="action-grid">
      <view class="action-item" bindtap="refreshData">
        <view class="action-icon">🔄</view>
        <view class="action-text">刷新数据</view>
      </view>
      
      <view class="action-item" bindtap="exportReport">
        <view class="action-icon">📊</view>
        <view class="action-text">导出报告</view>
      </view>
      
      <view class="action-item" bindtap="viewSettings">
        <view class="action-icon">⚙️</view>
        <view class="action-text">系统设置</view>
      </view>
      
      <view class="action-item" bindtap="viewHelp">
        <view class="action-icon">❓</view>
        <view class="action-text">帮助中心</view>
      </view>
    </view>
  </view>

  <!-- 底部间距 -->
  <view class="bottom-spacer"></view>
</view>

<!-- 加载动画 -->
<view class="loading-overlay" wx:if="{{isLoading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">数据加载中...</text>
</view>
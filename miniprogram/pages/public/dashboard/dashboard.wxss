/* 主容器 */
.dashboard-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 20rpx;
  box-sizing: border-box;
}

/* 顶部标题区域 */
.header-section {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 40rpx 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
}

.stat-icon {
  margin-right: 20rpx;
}

.stat-icon .icon {
  font-size: 40rpx;
}

.stat-content {
  flex: 1;
}

.stat-number {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 5rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

/* 实时状态区域 */
.realtime-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-indicator {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

.status-indicator.online {
  background: #52c41a;
}

.status-indicator.offline {
  background: #ff4d4f;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}

/* 进行中的考试 */
.ongoing-exams {
  margin-top: 20rpx;
}

.subsection-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #555;
  margin-bottom: 20rpx;
}

.exam-list {
  space-y: 15rpx;
}

.exam-item {
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  border-left: 6rpx solid #1890ff;
}

.exam-info {
  margin-bottom: 15rpx;
}

.exam-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.exam-time {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 5rpx;
}

.exam-location {
  font-size: 24rpx;
  color: #888;
}

.exam-progress {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #e6f7ff;
  border-radius: 4rpx;
  overflow: hidden;
  margin-right: 15rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1890ff, #40a9ff);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
}

.exam-participants {
  text-align: right;
}

.participants-count {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 5rpx 12rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #999;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 今日考试概览 */
.today-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.date-text {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

/* 时间轴 */
.today-timeline {
  margin-top: 25rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 15rpx;
  top: 40rpx;
  width: 2rpx;
  height: calc(100% + 10rpx);
  background: #e6f7ff;
}

.timeline-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  margin-top: 5rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.timeline-dot.completed {
  background: #52c41a;
}

.timeline-dot.ongoing {
  background: #1890ff;
  animation: pulse 2s infinite;
}

.timeline-dot.pending {
  background: #faad14;
}

.timeline-dot.cancelled {
  background: #ff4d4f;
}

.timeline-content {
  flex: 1;
}

.timeline-time {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.timeline-details {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.detail-item {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.detail-item.status-completed {
  background: #f6ffed;
  color: #52c41a;
}

.detail-item.status-ongoing {
  background: #e6f7ff;
  color: #1890ff;
}

.detail-item.status-pending {
  background: #fffbe6;
  color: #faad14;
}

.detail-item.status-cancelled {
  background: #fff2f0;
  color: #ff4d4f;
}

/* 快速操作区域 */
.quick-actions {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 25rpx;
}

.action-item {
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.action-item:hover {
  background: #e6f7ff;
  border-color: #1890ff;
  transform: translateY(-2rpx);
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 底部间距 */
.bottom-spacer {
  height: 200rpx;
}

/* 加载动画 */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top: 6rpx solid #ffffff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #ffffff;
  font-size: 28rpx;
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .stats-grid {
    grid-template-columns: 1fr;
  }
  
  .action-grid {
    grid-template-columns: 1fr;
  }
  
  .timeline-details {
    flex-direction: column;
    gap: 8rpx;
  }
}
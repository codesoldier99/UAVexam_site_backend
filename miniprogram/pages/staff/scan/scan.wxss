/* 考官扫码签到页面 - 优化版 */

/* 全局容器 */
.container {
  height: 100vh;
  background: linear-gradient(180deg, #6366f1 0%, #8b5cf6 100%);
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 20rpx;
  padding-top: 40rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
}

.nav-left {
  display: flex;
  flex-direction: column;
}

.staff-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.2;
}

.exam-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.nav-right {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.logout-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

/* 主要内容区域 */
.main-content {
  flex: 1;
  padding: 20rpx 20rpx;
  padding-bottom: 20rpx;
}

/* 统计区域 */
.stats-section {
  margin-bottom: 20rpx;
}

.stats-header {
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #6366f1;
  line-height: 1;
}

.stat-card.success .stat-number {
  color: #10b981;
}

.stat-card.failed .stat-number {
  color: #ef4444;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

/* 扫码区域 */
.scan-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  backdrop-filter: blur(10rpx);
}

.scan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.scan-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.scan-controls {
  display: flex;
  gap: 16rpx;
}

.control-item {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
}

.control-icon {
  font-size: 28rpx;
  opacity: 0.6;
  transition: opacity 0.3s;
}

.control-icon.active {
  opacity: 1;
}

.scan-container {
  position: relative;
  height: 320rpx;
}

/* 相机视图 */
.camera-view {
  width: 100%;
  height: 100%;
}

.scan-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.scan-frame {
  position: relative;
  width: 300rpx;
  height: 300rpx;
}

.frame-corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #6366f1;
}

.frame-corner.tl {
  top: 0;
  left: 0;
  border-right: none;
  border-bottom: none;
}

.frame-corner.tr {
  top: 0;
  right: 0;
  border-left: none;
  border-bottom: none;
}

.frame-corner.bl {
  bottom: 0;
  left: 0;
  border-right: none;
  border-top: none;
}

.frame-corner.br {
  bottom: 0;
  right: 0;
  border-left: none;
  border-top: none;
}

.scan-tip {
  margin-top: 30rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
}

/* 扫码占位符 */
.scan-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  background: #f8fafc;
}

.placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.placeholder-title {
  font-size: 28rpx;
  color: #6b7280;
  margin-bottom: 30rpx;
}

.scan-button {
  background: #6366f1;
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 50rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.scan-button.scanning {
  background: #9ca3af;
}

.scan-button::after {
  border: none;
}

/* 快捷操作 */
.actions-section {
  margin-bottom: 20rpx;
}

.actions-grid {
  display: flex;
  gap: 16rpx;
}

.action-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  border: none;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  backdrop-filter: blur(10rpx);
}

.action-item.primary {
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 4rpx 20rpx rgba(99, 102, 241, 0.2);
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.action-item::after {
  border: none;
}

/* 扫描记录 */
.history-section {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

.history-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.history-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.history-count {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

.history-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.history-item:last-child {
  border-bottom: none;
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.history-time {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.history-status {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-status.success {
  background: #dcfce7;
}

.history-status.failed {
  background: #fef2f2;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
}

.history-status.success .status-text {
  color: #16a34a;
}

.history-status.failed .status-text {
  color: #dc2626;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx;
}

.empty-icon {
  font-size: 60rpx;
  opacity: 0.4;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #9ca3af;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-dialog {
  background: #fff;
  border-radius: 20rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
}

.modal-content {
  padding: 30rpx;
}

.input-step,
.confirm-step {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.input-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.input-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.input-field {
  padding: 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f9fafb;
}

.input-field:focus {
  border-color: #6366f1;
  background: #fff;
}

.confirm-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.confirm-item:last-child {
  border-bottom: none;
}

.confirm-label {
  font-size: 28rpx;
  color: #6b7280;
}

.confirm-value {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.modal-footer {
  padding: 30rpx;
  border-top: 1rpx solid #f1f5f9;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.modal-btn.primary {
  background: #6366f1;
  color: #fff;
}

.modal-btn.secondary {
  background: #f3f4f6;
  color: #6b7280;
}

.modal-btn::after {
  border: none;
}

/* 结果提示 */
.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.toast-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  width: 480rpx;
  text-align: center;
}

.toast-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.toast-content.success .toast-icon {
  color: #10b981;
}

.toast-content.error .toast-icon {
  color: #ef4444;
}

.toast-message {
  display: block;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.toast-btn {
  background: #6366f1;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.toast-btn::after {
  border: none;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .stats-grid {
    gap: 12rpx;
  }
  
  .stat-card {
    padding: 24rpx 16rpx;
  }
  
  .stat-number {
    font-size: 40rpx;
  }
  
  .actions-grid {
    flex-direction: column;
  }
  
  .modal-dialog {
    width: 90vw;
  }
}
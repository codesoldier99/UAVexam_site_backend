<!--工作人员扫码签到页面-->
<view class="container">
  <!-- 顶部导航栏 -->
  <view class="navbar">
    <view class="nav-left">
      <text class="staff-name">{{staffInfo.name || '考官'}}</text>
      <text class="exam-name">{{examInfo.name || '考试管理'}}</text>
    </view>
    <view class="nav-right" bindtap="logout">
      <text class="logout-text">退出</text>
    </view>
  </view>

  <!-- 主要内容 -->
  <scroll-view class="main-content" scroll-y="true">
    
    <!-- 今日统计 -->
    <view class="stats-section">
      <view class="stats-header">
        <text class="stats-title">今日统计</text>
      </view>
      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-number">{{todayStats.total}}</text>
          <text class="stat-label">总扫描</text>
        </view>
        <view class="stat-card success">
          <text class="stat-number">{{todayStats.success}}</text>
          <text class="stat-label">成功</text>
        </view>
        <view class="stat-card failed">
          <text class="stat-number">{{todayStats.failed}}</text>
          <text class="stat-label">失败</text>
        </view>
      </view>
    </view>

    <!-- 扫码区域 -->
    <view class="scan-section">
      <view class="scan-header">
        <text class="scan-title">二维码扫描</text>
        <view class="scan-controls" wx:if="{{cameraAuth && isScanning}}">
          <view class="control-item" bindtap="toggleFlash">
            <text class="control-icon {{flashEnabled ? 'active' : ''}}">💡</text>
          </view>
        </view>
      </view>
      
      <view class="scan-container">
        <!-- 相机预览 -->
        <camera 
          wx:if="{{cameraAuth && isScanning}}"
          class="camera-view"
          device-position="back"
          flash="{{flashEnabled ? 'on' : 'off'}}"
          bindscancode="onScanCode"
          bindstop="onCameraStop"
          binderror="onCameraError">
          <cover-view class="scan-overlay">
            <cover-view class="scan-frame">
              <cover-view class="frame-corner tl"></cover-view>
              <cover-view class="frame-corner tr"></cover-view>
              <cover-view class="frame-corner bl"></cover-view>
              <cover-view class="frame-corner br"></cover-view>
            </cover-view>
            <cover-text class="scan-tip">将二维码对准扫描框</cover-text>
          </cover-view>
        </camera>
        
        <!-- 扫码占位符 -->
        <view wx:else class="scan-placeholder">
          <view class="placeholder-content">
            <text class="placeholder-icon">📷</text>
            <text class="placeholder-title">{{cameraAuth ? '点击开始扫描' : '需要开启相机权限'}}</text>
            <button 
              class="scan-button {{isScanning ? 'scanning' : ''}}"
              bindtap="{{cameraAuth ? 'startScan' : 'requestCameraAuth'}}"
              disabled="{{isScanning}}">
              {{cameraAuth ? (isScanning ? '扫描中...' : '开始扫描') : '开启相机'}}
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="actions-section">
      <view class="actions-grid">
        <button class="action-item primary" bindtap="showManualCheckinModal">
          <text class="action-icon">✏️</text>
          <text class="action-text">手动签到</text>
        </button>
        <button class="action-item" bindtap="toggleHistory">
          <text class="action-icon">📋</text>
          <text class="action-text">扫描记录</text>
        </button>
      </view>
    </view>

    <!-- 扫描记录 -->
    <view class="history-section" wx:if="{{showHistory}}">
      <view class="history-header">
        <text class="history-title">最近记录</text>
        <text class="history-count">({{recentScans.length}})</text>
      </view>
      <view class="history-list">
        <view 
          wx:for="{{recentScans}}" 
          wx:key="id" 
          class="history-item">
          <view class="history-info">
            <text class="history-name">{{item.candidateName}}</text>
            <text class="history-time">{{item.scanTime}}</text>
          </view>
          <view class="history-status {{item.status}}">
            <text class="status-text">{{item.status === 'success' ? '✓' : '✗'}}</text>
          </view>
        </view>
        <view wx:if="{{recentScans.length === 0}}" class="empty-state">
          <text class="empty-icon">📝</text>
          <text class="empty-text">暂无扫描记录</text>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- 手动签到弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideManualCheckinModal">
    <view class="modal-dialog" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">手动签到</text>
        <text class="modal-close" bindtap="hideManualCheckinModal">✕</text>
      </view>
      
      <view class="modal-content">
        <!-- 步骤1: 输入信息 -->
        <view wx:if="{{manualCheckin.step === 1}}" class="input-step">
          <view class="input-group">
            <text class="input-label">考生姓名</text>
            <input 
              class="input-field"
              placeholder="请输入考生姓名"
              value="{{manualCheckin.name}}"
              bindinput="onManualNameInput" />
          </view>
          <view class="input-group">
            <text class="input-label">身份证号</text>
            <input 
              class="input-field"
              placeholder="请输入身份证号"
              value="{{manualCheckin.idCard}}"
              bindinput="onManualIdCardInput" />
          </view>
        </view>

        <!-- 步骤2: 确认信息 -->
        <view wx:if="{{manualCheckin.step === 2}}" class="confirm-step">
          <view class="confirm-item">
            <text class="confirm-label">姓名</text>
            <text class="confirm-value">{{manualCheckin.name}}</text>
          </view>
          <view class="confirm-item">
            <text class="confirm-label">身份证</text>
            <text class="confirm-value">{{manualCheckin.idCard}}</text>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button 
          wx:if="{{manualCheckin.step === 1}}"
          class="modal-btn primary"
          bindtap="nextManualStep"
          disabled="{{!manualCheckin.name || !manualCheckin.idCard}}">
          下一步
        </button>
        <view wx:if="{{manualCheckin.step === 2}}" class="modal-actions">
          <button class="modal-btn secondary" bindtap="prevManualStep">返回</button>
          <button 
            class="modal-btn primary"
            bindtap="confirmManualCheckin"
            loading="{{manualCheckin.isLoading}}">
            确认签到
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- 结果提示 -->
  <view class="toast-mask" wx:if="{{showResult}}">
    <view class="toast-content {{resultType}}">
      <text class="toast-icon">{{resultType === 'success' ? '✓' : '✗'}}</text>
      <text class="toast-message">{{resultMessage}}</text>
      <button class="toast-btn" bindtap="hideResult">确定</button>
    </view>
  </view>

</view>
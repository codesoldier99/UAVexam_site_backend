<view class="container">
  <!-- 头部信息 -->
  <view class="header-info card">
    <view class="staff-info">
      <view class="avatar">👨‍💼</view>
      <view class="staff-details">
        <view class="name">{{staffInfo.name}}</view>
        <view class="department">{{staffInfo.department}}</view>
      </view>
    </view>
    <view class="logout-btn" bindtap="logout">
      <text class="logout-icon">⚙️</text>
    </view>
  </view>

  <!-- 今日统计 -->
  <view class="stats-section card">
    <view class="section-title">今日统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-number">{{todayStats.totalScans}}</view>
        <view class="stat-label">总扫码</view>
      </view>
      <view class="stat-item success">
        <view class="stat-number">{{todayStats.successfulCheckins}}</view>
        <view class="stat-label">成功签到</view>
      </view>
      <view class="stat-item failed">
        <view class="stat-number">{{todayStats.failedCheckins}}</view>
        <view class="stat-label">失败次数</view>
      </view>
    </view>
  </view>

  <!-- 扫码区域 -->
  <view class="scanner-section card">
    <view class="section-title">扫码签到</view>
    
    <!-- 扫码状态显示 -->
    <view class="scan-status status-{{checkInStatus}}">
      <view class="status-icon">
        <text wx:if="{{checkInStatus === 'idle'}}">📱</text>
        <text wx:elif="{{checkInStatus === 'scanning'}}">🔍</text>
        <text wx:elif="{{checkInStatus === 'processing'}}">⏳</text>
        <text wx:elif="{{checkInStatus === 'success'}}">✅</text>
        <text wx:elif="{{checkInStatus === 'failed'}}">❌</text>
      </view>
      <view class="status-text">
        <text wx:if="{{checkInStatus === 'idle'}}">点击开始扫码</text>
        <text wx:elif="{{checkInStatus === 'scanning'}}">扫码中...</text>
        <text wx:elif="{{checkInStatus === 'processing'}}">处理中...</text>
        <text wx:elif="{{checkInStatus === 'success'}}">签到成功</text>
        <text wx:elif="{{checkInStatus === 'failed'}}">签到失败</text>
      </view>
      <view wx:if="{{checkInMessage}}" class="status-message">
        {{checkInMessage}}
      </view>
    </view>

    <!-- 考生信息显示 -->
    <view wx:if="{{candidateInfo && examInfo}}" class="candidate-info">
      <view class="info-title">考生信息</view>
      <view class="info-grid">
        <view class="info-row">
          <text class="info-label">姓名：</text>
          <text class="info-value">{{candidateInfo.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">身份证：</text>
          <text class="info-value">{{candidateInfo.id_number}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">考试：</text>
          <text class="info-value">{{examInfo.exam_name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">时间：</text>
          <text class="info-value">{{examInfo.exam_time}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">地点：</text>
          <text class="info-value">{{examInfo.venue}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button 
        wx:if="{{checkInStatus === 'idle' || checkInStatus === 'failed'}}"
        class="btn-primary scan-btn" 
        bindtap="startScan"
        disabled="{{isScanning}}"
      >
        <text class="btn-icon">📷</text>
        {{isScanning ? '扫码中...' : '开始扫码'}}
      </button>
      
      <button 
        wx:if="{{checkInStatus === 'failed' && retryCount < maxRetries}}"
        class="btn-secondary retry-btn" 
        bindtap="retryScan"
      >
        <text class="btn-icon">🔄</text>
        重试 ({{retryCount}}/{{maxRetries}})
      </button>
      
      <button 
        wx:if="{{checkInStatus === 'success' || checkInStatus === 'failed'}}"
        class="btn-secondary reset-btn" 
        bindtap="resetScanState"
      >
        <text class="btn-icon">🆕</text>
        继续扫码
      </button>
    </view>

    <!-- 手动输入区域 -->
    <view class="manual-input-section">
      <view class="manual-toggle" bindtap="toggleManualInput">
        <text class="toggle-icon">{{showManualInput ? '🔼' : '🔽'}}</text>
        <text class="toggle-text">手动输入签到码</text>
      </view>
      
      <view wx:if="{{showManualInput}}" class="manual-input-form">
        <view class="input-group">
          <input 
            class="manual-code-input" 
            type="number"
            maxlength="6"
            placeholder="请输入6位签到码"
            value="{{manualCode}}"
            bindinput="onManualCodeInput"
          />
          <button 
            class="btn-primary submit-btn" 
            bindtap="submitManualCode"
            disabled="{{!manualCode || manualCode.length !== 6}}"
          >
            提交
          </button>
        </view>
        <view class="input-tip">
          如果二维码无法扫描，请考生提供6位签到码
        </view>
      </view>
    </view>
  </view>

  <!-- 扫码历史 -->
  <view class="history-section card">
    <view class="section-header" bindtap="toggleHistory">
      <view class="section-title">扫码历史</view>
      <view class="toggle-icon">{{showHistory ? '🔼' : '🔽'}}</view>
    </view>
    
    <view wx:if="{{showHistory}}" class="history-list">
      <view wx:if="{{scanHistory.length === 0}}" class="empty-history">
        <text class="empty-icon">📋</text>
        <text class="empty-text">暂无扫码记录</text>
      </view>
      
      <view wx:for="{{scanHistory}}" wx:key="id" class="history-item">
        <view class="history-info">
          <view class="history-name">{{item.candidate_name}}</view>
          <view class="history-exam">{{item.exam_name}}</view>
          <view class="history-time">{{item.checkin_time}}</view>
        </view>
        <view class="history-status status-{{item.status}}">
          <text wx:if="{{item.status === 'success'}}">✅</text>
          <text wx:elif="{{item.status === 'failed'}}">❌</text>
          <text wx:else>⏳</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 错误提示 -->
  <view wx:if="{{lastError}}" class="error-section">
    <view class="error-content">
      <view class="error-icon">⚠️</view>
      <view class="error-message">{{lastError}}</view>
      <button class="btn-secondary clear-error-btn" bindtap="clearError">
        清除
      </button>
    </view>
  </view>
</view>